---
import Base from '../layouts/Base.astro';
import { CONCRETO, fmt, type Resistencia } from '../lib/obra';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Cuántas bolsas de cemento se usan por m³?',
    a: 'Depende de la resistencia: aproximadamente 7 bolsas para f\'c 140, 8 para 175, 9.5 para 210 y 11.5 para 280. La calculadora usa esos valores referenciales.',
  },
  {
    q: '¿Qué resistencia necesito?',
    a: 'Para pisos y veredas suele bastar f\'c 140 o 175. Para columnas, vigas y losas se usa f\'c 210 o más, según el diseño estructural.',
  },
  {
    q: '¿El agua se mide en litros?',
    a: 'Sí. La calculadora muestra metros cúbicos, pero 1 m³ equivale a 1,000 litros. La relación agua/cemento no debe subir para no perder resistencia.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de cemento y concreto por m³',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---

<Base
  title="Calculadora de cemento y concreto por m³ — Calcula Obra"
  description="Calcula bolsas de cemento, arena, piedra y agua para tu vaciado de concreto. Elige la resistencia y el volumen en metros cúbicos."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de cemento y concreto</h1>
      <p class="sub">Ingresa las medidas del vaciado y la resistencia. Te decimos cuántas bolsas y agregados comprar.</p>
      <form id="cem-form">
        <label for="largo">Largo (m)</label>
        <input id="largo" type="number" min="0" step="0.01" value="4" required />

        <label for="ancho">Ancho (m)</label>
        <input id="ancho" type="number" min="0" step="0.01" value="3" required />

        <label for="espesor">Espesor (m)</label>
        <input id="espesor" type="number" min="0" step="0.01" value="0.1" required />
        <div class="hint">10 cm = 0.10 m. Para una losa de 15 cm, escribe 0.15.</div>

        <label for="resistencia">Resistencia del concreto</label>
        <select id="resistencia">
          {Object.keys(CONCRETO).map((r) => (
            <option value={r}>f'c {r} kg/cm²</option>
          ))}
        </select>

        <label for="desperdicio">Desperdicio (%)</label>
        <input id="desperdicio" type="number" min="0" max="20" step="1" value="5" />

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular materiales</button>
      </form>
      <div class="warn">
        Dosificación referencial. Para elementos estructurales usa el diseño de mezcla de un ingeniero:
        la cantidad de agua y agregados cambia según la humedad y el tamaño del agregado.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Bolsas de cemento</div>
        <div class="big" id="cem-bolsas">0</div>
        <div class="row"><span>Volumen de concreto</span><b id="cem-volumen">0.00 m³</b></div>
        <div class="row"><span>Arena</span><b id="cem-arena">0.00 m³</b></div>
        <div class="row"><span>Piedra</span><b id="cem-piedra">0.00 m³</b></div>
        <div class="row"><span>Agua</span><b id="cem-agua">0 l</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        Las bolsas son de 42.5 kg. Los agregados se muestran en metros cúbicos y el agua en litros.
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula el concreto?</h2>
      <p>
        Primero se obtiene el volumen: <strong>largo × ancho × espesor</strong>. Luego se multiplica por
        el consumo de materiales de la resistencia elegida.
      </p>
      <p>
        Para f'c 210 se usan aproximadamente 9.5 bolsas de cemento, 0.52 m³ de arena, 0.53 m³ de piedra
        y 175 litros de agua por cada metro cúbico. Son valores de obra referenciales, no un diseño de
        mezcla certificado.
      </p>
      <h2>Ejemplo</h2>
      <p>
        Un piso de 4 × 3 m con 10 cm de espesor son 1.2 m³. Con f'c 210 y 5% de desperdicio:
        12 bolsas de cemento, 0.62 m³ de arena y 0.64 m³ de piedra.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const DOSIS = {
        '140': { bolsas: 7.0, arena: 0.56, piedra: 0.56, agua: 0.185 },
        '175': { bolsas: 8.0, arena: 0.54, piedra: 0.55, agua: 0.18 },
        '210': { bolsas: 9.5, arena: 0.52, piedra: 0.53, agua: 0.175 },
        '280': { bolsas: 11.5, arena: 0.5, piedra: 0.51, agua: 0.17 },
      };
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const fmt = (n, d = 2) => new Intl.NumberFormat('es-PE', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

      document.getElementById('cem-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const volumen = num('largo') * num('ancho') * num('espesor');
        const r = document.getElementById('resistencia').value;
        const desp = 1 + Math.min(0.2, Math.max(0, num('desperdicio') / 100));
        const d = DOSIS[r];

        document.getElementById('cem-bolsas').textContent = Math.ceil(volumen * d.bolsas * desp).toLocaleString('es-PE');
        document.getElementById('cem-volumen').textContent = fmt(volumen) + ' m³';
        document.getElementById('cem-arena').textContent = fmt(volumen * d.arena * desp) + ' m³';
        document.getElementById('cem-piedra').textContent = fmt(volumen * d.piedra * desp) + ' m³';
        document.getElementById('cem-agua').textContent = Math.round(volumen * d.agua * 1000 * desp) + ' l';
      });

      document.getElementById('cem-form').requestSubmit();
    })();
  </script>
</Base>
