---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Cuántas losetas entran en un metro cuadrado?',
    a: 'Una loseta de 30 × 30 cm rinde 11.1 unidades por m²; una de 40 × 40 cm, 6.25; y una de 60 × 60 cm, 2.78. La calculadora redondea hacia arriba y suma el desperdicio.',
  },
  {
    q: '¿Cuánto desperdicio debo considerar?',
    a: '10% es lo habitual por cortes y roturas. Sube a 15% si el ambiente tiene muchos ángulos, columnas o un patrón diagonal.',
  },
  {
    q: '¿Las cajas se venden por metro cuadrado?',
    a: 'Depende de la tienda. La calculadora muestra unidades y cajas según el rendimiento típico; confirma cuántas unidades trae la caja que vas a comprar.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de losetas y porcelanato por m²',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---

<Base
  title="Calculadora de losetas y porcelanato por m² — Calcula Obra"
  description="Calcula cuántas losetas y cajas necesitas para tu piso o pared. Elige el tamaño, el área y el desperdicio."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de losetas</h1>
      <p class="sub">Para cerámica o porcelanato. Ingresa el área del ambiente y el tamaño de la loseta.</p>
      <form id="los-form">
        <label for="area">Área del ambiente (m²)</label>
        <input id="area" type="number" min="0" step="0.1" value="20" required />

        <label for="tamano">Tamaño de la loseta</label>
        <select id="tamano">
          <option value="0.30">30 × 30 cm</option>
          <option value="0.40">40 × 40 cm</option>
          <option value="0.60" selected>60 × 60 cm</option>
        </select>

        <label for="caja">Unidades por caja</label>
        <input id="caja" type="number" min="1" step="1" value="4" required />
        <div class="hint">Revisa la caja: suele indicar el rendimiento en m² y las unidades.</div>

        <label for="desperdicio">Desperdicio (%)</label>
        <input id="desperdicio" type="number" min="0" max="25" step="1" value="10" />

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular losetas</button>
      </form>
      <div class="warn">
        Cálculo referencial. Los cortes, el diseño diagonal y los ambientes irregulares aumentan el
        desperdicio. Compra una caja adicional si el modelo puede agotarse.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Losetas necesarias</div>
        <div class="big" id="los-unidades">0</div>
        <div class="row"><span>Cajas</span><b id="los-cajas">0</b></div>
        <div class="row"><span>Unidades por m²</span><b id="los-m2">0.00</b></div>
        <div class="row"><span>Área cubierta por caja</span><b id="los-area-caja">0.00 m²</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        Las cajas se redondean hacia arriba. Confirma el rendimiento real en la ficha del producto.
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calculan las losetas?</h2>
      <p>
        Se divide el área del ambiente entre el área de una loseta y se suma el desperdicio:
      </p>
      <p><strong>Unidades = (área ÷ (lado × lado)) × (1 + desperdicio)</strong></p>
      <p>
        Una loseta de 60 × 60 cm cubre 0.36 m², así que entran 2.78 unidades por m². Para 20 m² con 10%
        de desperdicio: 62 losetas.
      </p>
      <h2>Antes de comprar</h2>
      <p>
        Verifica el tono y el lote de fabricación. Si compras en dos tandas, puede haber diferencia de
        color. Guarda una caja sin abrir para futuras reparaciones.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const fmt = (n, d = 2) => new Intl.NumberFormat('es-PE', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

      document.getElementById('los-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const area = num('area');
        const lado = Math.max(0.1, parseFloat(document.getElementById('tamano').value) || 0.6);
        const porCaja = Math.max(1, Math.floor(num('caja')));
        const desp = 1 + Math.min(0.25, Math.max(0, num('desperdicio') / 100));
        const porM2 = 1 / (lado * lado);
        const unidades = Math.ceil(area * porM2 * desp);

        document.getElementById('los-unidades').textContent = unidades.toLocaleString('es-PE');
        document.getElementById('los-cajas').textContent = Math.ceil(unidades / porCaja).toLocaleString('es-PE');
        document.getElementById('los-m2').textContent = fmt(porM2);
        document.getElementById('los-area-caja').textContent = fmt(porCaja * lado * lado) + ' m²';
      });

      document.getElementById('los-form').requestSubmit();
    })();
  </script>
</Base>
