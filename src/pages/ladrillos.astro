---
import Base from '../layouts/Base.astro';
import { LADRILLOS, fmt, unidadesPorM2, type TipoLadrillo } from '../lib/obra';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Cuántos ladrillos entran en un metro cuadrado?',
    a: 'Con junta de 1.5 cm: unos 37 ladrillos King Kong de 18 huecos, 33 pandereta y 18 bloques de concreto de 12 cm. La calculadora usa esas dimensiones y suma el desperdicio.',
  },
  {
    q: '¿Cuánto desperdicio debo considerar?',
    a: 'Entre 5% y 10% para una pared recta. Sube a 10% o 15% si hay cortes, esquinas, columnas o vanos.',
  },
  {
    q: '¿La cantidad incluye el mortero?',
    a: 'El cálculo muestra una estimación de mortero aparte. Para una pared de soga se usa alrededor de 0.02 m³ por m².',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de ladrillos por metro cuadrado',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---

<Base
  title="Calculadora de ladrillos por m² — Calcula Obra"
  description="Calcula cuántos ladrillos King Kong, pandereta o bloques de concreto necesitas para tu pared. Incluye junta y desperdicio."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de ladrillos</h1>
      <p class="sub">Mide tu pared y elige el tipo de ladrillo. El resultado incluye junta y desperdicio.</p>
      <form id="lad-form">
        <label for="largo">Largo de la pared (m)</label>
        <input id="largo" type="number" min="0" step="0.01" value="4" required />

        <label for="alto">Alto de la pared (m)</label>
        <input id="alto" type="number" min="0" step="0.01" value="2.5" required />

        <label for="tipo">Tipo de ladrillo</label>
        <select id="tipo">
          {Object.entries(LADRILLOS).map(([id, l]) => (
            <option value={id}>{l.nombre} — {l.largo * 100} × {l.alto * 100} cm</option>
          ))}
        </select>

        <label for="desperdicio">Desperdicio (%)</label>
        <input id="desperdicio" type="number" min="0" max="25" step="1" value="5" />
        <div class="hint">5% para paredes rectas; 10–15% si hay cortes o vanos.</div>

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular ladrillos</button>
      </form>
      <div class="warn">
        Cálculo referencial para pared de soga. Confirma las dimensiones del ladrillo que vas a comprar:
        pueden variar algunos milímetros y cambiar la cantidad.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Ladrillos necesarios</div>
        <div class="big" id="lad-total">0</div>
        <div class="row"><span>Área de la pared</span><b id="lad-area">0.00 m²</b></div>
        <div class="row"><span>Unidades por m²</span><b id="lad-m2">0.0</b></div>
        <div class="row"><span>Mortero estimado</span><b id="lad-mortero">0.00 m³</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        Para una pared de soga se usa aproximadamente 0.02 m³ de mortero por m².
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula la cantidad de ladrillos?</h2>
      <p>
        Se calcula el área de la pared y se multiplica por las unidades que entran en un metro cuadrado.
        La cantidad por m² depende del largo y alto del ladrillo más el espesor de la junta:
      </p>
      <p><strong>Unidades por m² = 1 ÷ ((largo + junta) × (alto + junta))</strong></p>
      <p>
        Con una junta de 1.5 cm, un King Kong de 24 × 9 cm rinde unas 37 unidades por m². Luego se suma
        el desperdicio para cortes y roturas.
      </p>
      <h2>Ejemplo</h2>
      <p>
        Una pared de 4 × 2.5 m tiene 10 m². Con King Kong, 5% de desperdicio: 10 × 37.35 × 1.05 = 393
        ladrillos.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const DIM = {
        'king-kong-18': { largo: 0.24, alto: 0.09, junta: 0.015 },
        pandereta: { largo: 0.23, alto: 0.11, junta: 0.015 },
        'bloque-12': { largo: 0.39, alto: 0.12, junta: 0.015 },
        'bloque-15': { largo: 0.39, alto: 0.15, junta: 0.015 },
      };
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const fmt = (n, d = 2) => new Intl.NumberFormat('es-PE', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

      document.getElementById('lad-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const largo = num('largo');
        const alto = num('alto');
        const tipo = document.getElementById('tipo').value;
        const desp = Math.min(0.25, Math.max(0, num('desperdicio') / 100));
        const d = DIM[tipo];
        const area = largo * alto;
        const porM2 = 1 / ((d.largo + d.junta) * (d.alto + d.junta));
        const total = Math.ceil(area * porM2 * (1 + desp));

        document.getElementById('lad-total').textContent = total.toLocaleString('es-PE');
        document.getElementById('lad-area').textContent = fmt(area) + ' m²';
        document.getElementById('lad-m2').textContent = fmt(porM2, 1);
        document.getElementById('lad-mortero').textContent = fmt(area * 0.02, 3) + ' m³';
      });

      document.getElementById('lad-form').requestSubmit();
    })();
  </script>
</Base>
