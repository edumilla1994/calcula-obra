---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Cuántos metros cuadrados rinde un galón de pintura?',
    a: 'Un galón (3.785 litros) rinde entre 35 y 40 m² por mano en paredes lisas. En superficies rugosas o con mucho color puede bajar a 25–30 m².',
  },
  {
    q: '¿Cuántas manos de pintura debo dar?',
    a: 'Dos manos es lo estándar para cubrir bien. Si el color es muy distinto al anterior o la pared es nueva, considera tres manos.',
  },
  {
    q: '¿Debo descontar puertas y ventanas?',
    a: 'Sí. Mide el área de cada vano y réstala del total. Si no los descuentas, comprarás pintura de más.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de pintura por metro cuadrado',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---

<Base
  title="Calculadora de pintura por m² — Calcula Obra"
  description="Calcula cuántos litros y galones de pintura necesitas según el área, las manos y el rendimiento. Incluye desperdicio y baldes."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de pintura</h1>
      <p class="sub">Ingresa el área total a pintar. Si no la sabes, multiplica largo × alto de cada pared y súmalas.</p>
      <form id="pin-form">
        <label for="area">Área total a pintar (m²)</label>
        <input id="area" type="number" min="0" step="0.1" value="40" required />

        <label for="manos">Manos de pintura</label>
        <select id="manos">
          <option value="1">1 mano</option>
          <option value="2" selected>2 manos</option>
          <option value="3">3 manos</option>
        </select>

        <label for="rendimiento">Rendimiento de la pintura (m² por litro)</label>
        <input id="rendimiento" type="number" min="1" step="0.1" value="10" required />
        <div class="hint">Látex estándar: 10 m²/L por mano. Revisa la ficha del producto.</div>

        <label for="desperdicio">Desperdicio (%)</label>
        <input id="desperdicio" type="number" min="0" max="20" step="1" value="5" />

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular pintura</button>
      </form>
      <div class="warn">
        Rendimiento referencial. La superficie rugosa, el color base y la dilución cambian el consumo.
        Compra un 5% adicional si no conoces la pared.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Pintura necesaria</div>
        <div class="big" id="pin-litros">0.00 L</div>
        <div class="row"><span>Galones</span><b id="pin-galones">0.00</b></div>
        <div class="row"><span>Baldes de 4 galones</span><b id="pin-baldes">0</b></div>
        <div class="row"><span>Área por mano</span><b id="pin-area">0.00 m²</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        1 galón = 3.785 litros. Un balde estándar de 4 galones equivale a 15.14 litros.
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula la pintura?</h2>
      <p>
        Se multiplica el área por el número de manos y se divide entre el rendimiento del producto:
      </p>
      <p><strong>Litros = (área × manos ÷ rendimiento) × (1 + desperdicio)</strong></p>
      <p>
        Para 40 m², dos manos y un rendimiento de 10 m²/L: 8 litros. Con 5% de desperdicio, 8.4 litros,
        es decir 2.22 galones.
      </p>
      <h2>Antes de comprar</h2>
      <p>
        Descuenta puertas y ventanas, y revisa si la pintura es para interior o exterior. No mezcles
        marcas distintas en la misma pared: el tono puede cambiar.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const fmt = (n, d = 2) => new Intl.NumberFormat('es-PE', { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

      document.getElementById('pin-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const area = num('area');
        const manos = parseInt(document.getElementById('manos').value, 10) || 1;
        const rendimiento = Math.max(1, num('rendimiento'));
        const desp = 1 + Math.min(0.2, Math.max(0, num('desperdicio') / 100));
        const litros = (area * manos / rendimiento) * desp;
        const galones = litros / 3.785;

        document.getElementById('pin-litros').textContent = fmt(litros) + ' L';
        document.getElementById('pin-galones').textContent = fmt(galones);
        document.getElementById('pin-baldes').textContent = Math.max(1, Math.ceil(litros / 15.14)).toLocaleString('es-PE');
        document.getElementById('pin-area').textContent = fmt(area) + ' m²';
      });

      document.getElementById('pin-form').requestSubmit();
    })();
  </script>
</Base>
